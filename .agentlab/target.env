# OneFLOW target overlay. Sourced by .agentlab/domain.env after it is installed.
TARGET=oneflow

# Local collaboration base. OneFLOW's agent rules prefer `hexin`; this checkout
# currently has `dev`. Use BASE_REF=upstream/hexin for PR-compatible worktrees.
BASE_REF=dev

# v0.1: read-only audit. Switch to `worker` only after the human approves scopes
# and contracts from the audit reports.
AGENTLAB_MODE=audit

# Two read-only workstreams first. Do not force the starter's spatial/temporal
# split onto OneFLOW before the audit maps real boundaries.
MODULES="runtime-io numerics"

# Candidate commands for later worker mode. Audit mode does not run them.
# OneFLOW needs its own dependency setup (MPI/METIS/CGNS/HIP) before this is trusted.
BUILD_CMD="cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DMPI_ENABLE=ON -DMETIS_ENABLE=ON -DCGNS_ENABLE=ON && cmake --build build -j2"
# OneFLOW has no `unit` CTest label (ctest -L unit finds 0 tests). Run the whole
# CTest suite as the target defines it; do not invent a label scheme.
UNIT_CMD="ctest --test-dir build --output-on-failure"
VERIFY_CMD="bash .agentlab/verification/run_all.sh"

# OneFLOW's shared numeric foundation is codes/, not a top-level core/.
REQUIRE_CORE=0
UNIT_DIR=tests

# GitHub source identity: agent account, not the human account.
GITHUB_CLI=gh-agent
GITHUB_REPOSITORY=lql341/OneFLOW

# Attention policy: pending | review | fyi | ignore
ATTENTION_NEED_DECISION=pending
ATTENTION_RFC=pending
ATTENTION_BLOCKED=pending
ATTENTION_GATE_FAIL=pending
ATTENTION_GATE_UNVERIFIED=review
ATTENTION_REPORT_READY=review
ATTENTION_WORKER_FAILURE=pending
ATTENTION_TICKET=pending
ATTENTION_TICKET_REVIEW=review
ATTENTION_CANDIDATE=pending
