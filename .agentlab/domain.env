DOMAIN=cfd
MODULES="spatial temporal"
BUILD_CMD="cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j2"
UNIT_CMD="ctest --test-dir build -L unit --output-on-failure"
VERIFY_CMD="bash .agentlab/verification/run_all.sh"

if [ -f .agentlab/target.env ]; then . .agentlab/target.env; fi
